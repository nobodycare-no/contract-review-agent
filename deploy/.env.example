# ===== 基础 =====
APP_ENV=dev
MYSQL_URL=mysql+pymysql://cra:cra123456@mysql:3306/contract_review?charset=utf8mb4
ADMIN_TOKEN=change-me-admin
UPLOAD_DIR=/srv/storage/attachments

# ===== LLM（Qwen3-8B @ AutoDL 6006）=====
# 填你的 AutoDL 实例公网映射地址（GPU 开机后从控制台复制），形如 https://xxxx.seetacloud.com:8443/v1
LLM_BASE_URL=
LLM_API_KEY=sk-atguigu
LLM_MODEL=qwen3-8b
LLM_TIMEOUT_S=120

# ===== 批量审查并行度（点击即排队 + 后台并行工人）=====
# 同时开跑的张数；GPU 版单张约 30~60 秒，3 并发下 5 张约 1~2 分钟跑完。
# 调大更快，但注意 AutoDL 实例的 vLLM 并发能力
BATCH_CONCURRENCY=3
