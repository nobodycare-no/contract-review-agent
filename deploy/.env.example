# ===== 基础 =====
APP_ENV=dev
MYSQL_URL=mysql+pymysql://cra:cra123456@mysql:3306/contract_review?charset=utf8mb4
ADMIN_TOKEN=change-me-admin
UPLOAD_DIR=/srv/storage/attachments

# ===== LLM（云端 BigModel OpenAI 兼容端点 · GLM）=====
# 默认走智谱 BigModel（zai-custom）；本地 GPU vLLM 备选见 deploy/GPU_VLLM_START.md
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=你的BigModel APIKey
LLM_MODEL=glm-5.3-flash
# 思考开关（仅 Agent 主线）：留空=不干预模型缺省行为；
# glm-5.3-flash 档位 low/high/max——默认重思考≈19s/轮，low 实证可将轮耗时降到约 8s。
# AI 审查层不带该参数（无 tools 请求 {"type":"low"} 400 实证），走默认思考+3000 预算
LLM_THINKING=low
LLM_TIMEOUT_S=120

# ===== Agent 步数预算（GLM 分支部署调优）=====
# 代码规范缺省 12（ADR-B8）；GLM-5.3-flash 决策更缜密、工具轮次更多，
# 真机实证 24 步递归上限不够闭环 → 部署值放宽到 20（recursion_limit=40）
AGENT_MAX_STEPS=20
